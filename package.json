    "db:generate": "prisma generate",
    "db:sql": "tsx scripts/gen-sql.ts",
    "postinstall": "prisma generate",
    "ai:bridge": "node scripts/opencode-bridge.mjs",
    "setup": "npm run db:migrate && npm run db:seed"
  },
